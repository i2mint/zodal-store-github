{
  "name": "@zodal/store-github",
  "version": "0.1.0",
  "description": "zodal DataProvider over the files of a GitHub repository folder (read-only, token in the browser)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0"
  },
  "devDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.3.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/i2mint/zodal-store-github.git"
  },
  "keywords": ["zodal", "dataprovider", "github", "contents-api", "read-only", "adapter"],
  "packageManager": "pnpm@9.15.0"
}
